PROGRAM TemperatureControl
VAR
    Tуст : REAL := 20.0; (* Уставка температуры *)
    ΔT : REAL := 1.0; (* Допустимое отклонение температуры *)
    Температура : REAL; (* Текущая температура *)
    СтупениТЭН : ARRAY[1..12] OF BOOL; (* Состояние ступеней ТЭНа *)
    КоличествоСтупеней : INT := 3; (* Количество ступеней, задается пользователем *)
    ТекущаяСтупень : INT := 1; (* Текущая включенная ступень *)
    ТаймерВключения : TON; (* Таймер для задержки включения следующей ступени *)
    ТаймерВремя : TIME := T#5M; (* Время задержки для включения следующей ступени *)
END_VAR

(* Основной алгоритм управления температурой *)
IF Температура < Tуст - ΔT THEN
    (* Температура ниже допустимого диапазона *)
    СтупениТЭН[ТекущаяСтупень] := FALSE;
    ТекущаяСтупень := ТекущаяСтупень + 1;
    IF ТекущаяСтупень <= КоличествоСтупеней THEN
        СтупениТЭН[ТекущаяСтупень] := TRUE;
        ТаймерВключения(IN:=TRUE, PT:=ТаймерВремя);
    END_IF;
ELSIF Температура > Tуст + ΔT THEN
    (* Температура выше допустимого диапазона *)
    СтупениТЭН[1] := TRUE;
    FOR i := 2 TO КоличествоСтупеней DO
        СтупениТЭН[i] := FALSE;
    END_FOR;
    ТекущаяСтупень := 1;
ELSE
    (* Температура в допустимом диапазоне *)
    СтупениТЭН[1] := TRUE;
    FOR i := 2 TO КоличествоСтупеней DO
        СтупениТЭН[i] := FALSE;
    END_FOR;
    ТекущаяСтупень := 1;
END_IF;

(* Обработка аварийных ситуаций *)
IF Температура > 25.0 THEN
    (* Аварийная ситуация: перегрев *)
    FOR i := 1 TO КоличествоСтупеней DO
        СтупениТЭН[i] := FALSE;
    END_FOR;
    ТекущаяСтупень := 1;
    (* Дополнительные действия по защите от перегрева *)
END_IF;
```

В этом обновленном коде:

1. Переменная `КоличествоСтупеней` используется для хранения общего количества ступеней ТЭНа.
2. Переменная `ТекущаяСтупень` используется для хранения номера текущей включенной ступени.

Это позволяет нам более четко разделить эти две концепции и избежать путаницы. Теперь алгоритм работает так же, как и в предыдущем варианте.

